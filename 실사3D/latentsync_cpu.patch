+def _sdpa_chunked(q, k, v, attn_mask=None, budget=6e8):
+    """CPU 메모리 아낌: 배치를 나눠 계산 (한 조각의 주의 행렬이 약 0.6GB 넘지 않게)"""
+    per = q.shape[1] * q.shape[2] * k.shape[2] * 4 if q.dim() == 4 else q.shape[1] * k.shape[1] * 4
+    n = max(1, int(budget // max(per, 1)))
+    if n >= q.shape[0]:
+        return F.scaled_dot_product_attention(q, k, v, attn_mask=attn_mask)
+    outs = []
+    for i in range(0, q.shape[0], n):
+        m = attn_mask[i:i + n] if attn_mask is not None and attn_mask.shape[0] == q.shape[0] else attn_mask
+        outs.append(F.scaled_dot_product_attention(q[i:i + n], k[i:i + n], v[i:i + n], attn_mask=m))
+    return torch.cat(outs, 0)
